# Canco Cares website — environment contract.
# Copy to .env.local for development. Never commit .env.local.

# --- Laravel API (server-side only) ---------------------------------------------
# Base URL of the public API, including /api/v1. The build and every page render call it,
# so the Laravel app must be reachable (and have at least one published story) when you run `npm run build`.
# The host here must match the host in Laravel's APP_URL: image URLs in API responses use APP_URL, and next/image only
# optimises images from the API's own host (see images.remotePatterns in next.config.ts).
API_URL=http://localhost:8000/api/v1
# Same value as FRONTEND_API_KEY in admin/.env. Sent as X-Api-Key so the API recognises this server
# (higher rate limit now; required for the write endpoints later).
API_KEY=
# Same value as REVALIDATE_SECRET in admin/.env. Laravel presents it when it asks this site to refresh its cache.
REVALIDATE_SECRET=

# --- Public values (safe to expose to the browser) ------------------------------
# Canonical origin of this site, used for canonical URLs, Open Graph and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Development only ----------------------------------------------------------
# next/image refuses to fetch from localhost/private IPs in production builds. Set to "true" only if the API
# really lives on a private address and you understand the SSRF trade-off (see Next docs: dangerouslyAllowLocalIP).
# ALLOW_LOCAL_IMAGE_HOST=true
